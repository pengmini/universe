rules_version = '2';

/* 소통의 우주 — Firestore 보안 규칙

   핵심 두 가지
   ① 교사 판정은 여기서만 한다. 클라이언트의 TEACHER_EMAIL 은 화면 이동용일 뿐이다.
   ② 중복 방지는 '문서 ID'로 한다. Firestore 에는 UNIQUE 제약이 없지만,
      create 는 문서가 이미 있으면 실패한다. 그래서 ID 를 결정론적으로 잡고,
      그 ID 가 본인 uid 로 만들어졌는지 규칙에서 검사한다.
        satellites/{topicId}__{uid}            → 한 주제에 한 사람 한 글
        interactions/{satId}__{uid}__{type}    → 한 글에 공감 1 · 댓글 1
*/
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn(){ return request.auth != null; }
    function uid(){ return request.auth.uid; }

    // ★ 교사 이메일. app/config.js 의 TEACHER_EMAIL 과 반드시 같게 유지할 것.
    function isTeacher(){
      return signedIn() && request.auth.token.email == "pengmini90@gmail.com"
             && request.auth.token.email_verified == true;
    }

    function okText(v, maxLen){
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    /* 글 — 로그인한 사람은 모두 읽는다. 쓰기는 본인 것만, 한 주제에 하나. */
    match /satellites/{satId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.uid == uid()
        && satId == request.resource.data.topicId + "__" + uid()
        && request.resource.data.topicId is string
        && okText(request.resource.data.content, 40)
        && okText(request.resource.data.studentName, 30)
        && request.resource.data.keys().hasOnly(
             ["topicId","uid","studentName","content","createdAt"]);

      // 수정은 아무도 못 한다. 지우는 건 교사만.
      allow update: if false;
      allow delete: if isTeacher();
    }

    /* 공감 · 댓글 */
    match /interactions/{actId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.fromUid == uid()
        && request.resource.data.type in ["like", "comment"]
        && actId == request.resource.data.satId + "__" + uid() + "__" + request.resource.data.type
        && exists(/databases/$(database)/documents/satellites/$(request.resource.data.satId))
        // 자기 글에는 공감·댓글을 달 수 없다
        && get(/databases/$(database)/documents/satellites/$(request.resource.data.satId)).data.uid != uid()
        && okText(request.resource.data.fromName, 30)
        && (request.resource.data.type == "like"
            ? request.resource.data.text == ""
            : okText(request.resource.data.text, 40))
        && request.resource.data.keys().hasOnly(
             ["satId","topicId","fromUid","fromName","type","text","createdAt"]);

      allow update: if false;
      allow delete: if isTeacher();
    }

    /* 그 밖의 경로는 전부 막는다 */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
